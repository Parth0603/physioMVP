# PHYSIO-SMART Environment Configuration Template
# Copy this file to .env and configure your environment-specific values

# Application
APP_NAME=PHYSIO-SMART
APP_ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="PHYSIO-SMART - AI-Powered Adaptive Learning"

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For local development, if postgres password is empty or custom, update here.
# SQLite fallback is also supported: sqlite:///./physiosmart.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/physiosmart

# Authentication & Security
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=supersecretjwtkey_for_development_replace_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Prepared for Parts 2-4)
# Note: Part 1 provides clean abstraction; AI calls will be activated in later phases
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3
